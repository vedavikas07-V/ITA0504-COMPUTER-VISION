
import cv2
import numpy as np
img = cv2.imread("C:/Users/vedav/OneDrive/Pictures/foxxy.jpg")

if img is None:
    print("Image not found")
    exit()

h, w = img.shape[:2]
src = np.float32([
    [w*0.2, h*0.2],
    [w*0.8, h*0.2],
    [w*0.8, h*0.8],
    [w*0.2, h*0.8]
])
dst = np.float32([
    [0, 0],
    [400, 0],
    [400, 400],
    [0, 400]
])
matrix = cv2.getPerspectiveTransform(src, dst)

print("Transformation Matrix:")
print(matrix)
result = cv2.warpPerspective(img, matrix, (400, 400))
cv2.imshow("Original Image", img)
cv2.imshow("Perspective Transformation", result)

cv2.waitKey(0)
cv2.destroyAllWindows()
