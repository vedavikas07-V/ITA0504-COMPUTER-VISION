import cv2
import numpy as np

def circle():
    h = int(input("Enter height: "))
    w = int(input("Enter width: "))

    img = np.ones((h, w, 3), dtype=np.uint8) * 255

    center = (w//2, h//2)
    radius = min(w, h)//4

    cv2.circle(img, center, radius, (255, 0, 0), 3)

    cv2.imshow("Circle", img)
    cv2.waitKey(0)
    cv2.destroyAllWindows()

circle()
