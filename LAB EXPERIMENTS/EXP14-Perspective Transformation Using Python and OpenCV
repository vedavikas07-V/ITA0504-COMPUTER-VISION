import cv2
import numpy as np

img = cv2.imread("C:/Users/vedav/OneDrive/Pictures/Screenshots/Screenshot 2026-10-09 231722.png")

if img is None:
    print("Error: Image not found!")
else:
    rows, cols = img.shape[:2]

    pts1 = np.float32([
        [50, 50],
        [cols - 50, 50],
        [50, rows - 50],
        [cols - 50, rows - 50]
    ])

    pts2 = np.float32([
        [0, 0],
        [cols - 1, 0],
        [50, rows - 1],
        [cols - 100, rows - 50]
    ])

    matrix = cv2.getPerspectiveTransform(pts1, pts2)

    transformed = cv2.warpPerspective(
        img, matrix, (cols, rows)
    )

    cv2.imshow("Original Image", img)
    cv2.imshow("Perspective Transformed Image", transformed)

    cv2.waitKey(0)
    cv2.destroyAllWindows()
