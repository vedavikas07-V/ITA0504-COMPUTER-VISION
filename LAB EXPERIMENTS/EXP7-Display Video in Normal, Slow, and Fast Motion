import cv2

cap = cv2.VideoCapture("video.mp4")

if not cap.isOpened():
    print("Error: Video not found!")
    exit()

fps = cap.get(cv2.CAP_PROP_FPS)

if fps <= 0:
    fps = 30

delay = int(1000 / fps)

print("Press 1 for Normal Motion")
print("Press 2 for Slow Motion")
print("Press 3 for Fast Motion")
print("Press Q to Quit")

mode = 1

while True:
    ret, frame = cap.read()

    if not ret:
        # Restart video when it reaches the end
        cap.set(cv2.CAP_PROP_POS_FRAMES, 0)
        continue

    cv2.imshow("Video Processing", frame)

    if mode == 1:
        key = cv2.waitKey(delay) & 0xFF

    elif mode == 2:
        key = cv2.waitKey(delay * 3) & 0xFF

    elif mode == 3:
        # Skip additional frames for fast motion
        cap.set(
            cv2.CAP_PROP_POS_FRAMES,
            cap.get(cv2.CAP_PROP_POS_FRAMES) + 2
        )
        key = cv2.waitKey(max(1, delay // 2)) & 0xFF

    if key == ord('1'):
        mode = 1
    elif key == ord('2'):
        mode = 2
    elif key == ord('3'):
        mode = 3
    elif key == ord('q'):
        break

cap.release()
cv2.destroyAllWindows()
