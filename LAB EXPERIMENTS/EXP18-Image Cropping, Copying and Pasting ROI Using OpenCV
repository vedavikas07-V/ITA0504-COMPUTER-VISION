import cv2

img = cv2.imread("C:/Users/vedav/OneDrive/Pictures/Screenshots/Screenshot 2026-10-09 231722.png")

if img is None:
    print("Error: Image not found!")
else:
    # Select ROI coordinates
    x1, y1 = 50, 50
    x2, y2 = 250, 250

    # Crop the ROI
    roi = img[y1:y2, x1:x2]

    # Copy the original image
    result = img.copy()

    # Get ROI dimensions
    h, w = roi.shape[:2]

    # Set the paste location
    paste_x, paste_y = 300, 100

    # Check whether ROI fits in the image
    if (paste_x + w <= result.shape[1] and
            paste_y + h <= result.shape[0]):

        # Paste the ROI into the image
        result[paste_y:paste_y+h,
               paste_x:paste_x+w] = roi

        # Display images
        cv2.imshow("Original Image", img)
        cv2.imshow("Cropped ROI", roi)
        cv2.imshow("Image After Pasting ROI", result)

        # Save the result
        cv2.imwrite("cropped_roi.jpg", roi)
        cv2.imwrite("pasted_image.jpg", result)

        cv2.waitKey(0)
        cv2.destroyAllWindows()

        print("ROI cropped, copied, and pasted successfully!")
    else:
        print("Error: Paste location is outside the image.")
