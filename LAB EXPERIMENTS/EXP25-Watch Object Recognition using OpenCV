import cv2
img = cv2.imread("C:/Users/vedav/OneDrive/Pictures/7a1ce3a2-ce72-4f50-8e3f-32830f31438a.png")
watch = cv2.imread("C:/Users/vedav/OneDrive/Pictures/2168102c-96dd-4c24-854e-d5490a6dbfa5.png")

gray1 = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
gray2 = cv2.cvtColor(watch, cv2.COLOR_BGR2GRAY)


orb = cv2.ORB_create()

kp1, des1 = orb.detectAndCompute(gray1, None)
kp2, des2 = orb.detectAndCompute(gray2, None)


if des1 is not None and des2 is not None:
    bf = cv2.BFMatcher(cv2.NORM_HAMMING)
    matches = bf.knnMatch(des1, des2, k=2)

    good = []
    for pair in matches:
        if len(pair) == 2:
            m, n = pair
            if m.distance < 0.75 * n.distance:
                good.append(m)

    result = cv2.drawMatches(
        img, kp1, watch, kp2, good, None
    )

    cv2.imshow("Watch Recognition", result)
else:
    print("Features not detected")

cv2.waitKey(0)
cv2.destroyAllWindows()
