import cv2

img = cv2.imread("C:/Users/vedav/OneDrive/Pictures/Screenshots/Screenshot 2026-10-09 231722.png")

if img is None:
    print("Error: Image not found!")
else:
    rotated = cv2.rotate(
        img, cv2.ROTATE_90_COUNTERCLOCKWISE
    )

    cv2.imshow("Original Image", img)
    cv2.imshow("Rotated Image - 270 Degrees Clockwise", rotated)

    cv2.waitKey(0)
    cv2.destroyAllWindows()
